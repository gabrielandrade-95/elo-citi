# IA principal: chave do Groq (console.groq.com > API Keys)
GROQ_API_KEY=
# IA de reserva: chave do Google AI Studio (aistudio.google.com > Get API key)
GEMINI_API_KEY=
# Opcionais: modelos em ordem de tentativa, separados por vírgula
GROQ_MODEL=openai/gpt-oss-120b,llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
